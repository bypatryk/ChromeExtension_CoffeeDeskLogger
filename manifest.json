{
  "manifest_version": 3,
  "name": "Coffeedesk.pl Logger",
  "version": "1.0.0",
  "key": "",
  "description": "Mark coffees you bought on coffeedesk.pl, rate them, add notes, and see your verdicts while you browse.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Coffeedesk.pl Logger",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.coffeedesk.pl/*",
        "*://coffeedesk.pl/*"
      ],
      "js": [
        "storage.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
